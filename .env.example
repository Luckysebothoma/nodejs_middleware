# nodejs_middleware environment variables
#
# Copy this file to .env in the same directory and fill in real values:
#   cp .env.example .env
#
# .env must never be committed -- confirm it's listed in .gitignore
# (this repo's gitignore file is oddly named "gitIgnore" -- double check
# .env is actually covered by it, or rename/fix that file).
#
# Every variable below is read somewhere in the running app (index.js via
# `npm run server`, keys.js, config/db.js, config/postgres.js,
# config/redisClient.js) or consumed directly by docker-compose.yml.

# --- PostgreSQL ---------------------------------------------------------
# Used by config/postgres.js to track/audit JWT auth tokens.
PGUSER=postgres
PGHOST=postgres
PGDATABASE=auth_token
PGPASSWORD=change_me
PGPORT=5432
RABBITMQ_URL=
TELEGRAF_URL=
# --- MySQL ---------------------------------------------------------------
# Primary application data: products, cart, pricing, stock, SOD/EOD, etc.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=sweety_sweet
MYSQL_USER=sweety_app
MYSQL_PASSWORD=change_me
# Only consumed by the MySQL container itself in docker-compose.yml
# (initializes the root account on first boot) -- the Node app never reads
# this one directly, but docker-compose.yml requires it to be set.
MYSQL_ROOT_PASSWORD=change_me

# --- Redis -----------------------------------------------------------------
# Caching layer (product list cache, temp image keys, token tracking).
REDIS_HOST=redis
REDIS_PORT=6379
# Declared in keys.js for forward compatibility; not currently read by
# config/redisClient.js, but set them anyway if your Redis instance needs
# auth so they're ready when that wiring is added.
REDIS_USER=default
REDIS_PASSWORD=change_me
