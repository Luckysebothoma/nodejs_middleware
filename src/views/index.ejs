<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cloudflare R2 Bucket Contents</title>
  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      margin: 0;
      padding: 20px;
      color: #333;
    }
    h1 {
      margin-bottom: 20px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    th, td {
      padding: 10px;
      text-align: left;
      border-bottom: 1px solid #ddd;
    }
    th {
      background-color: #f2f2f2;
      font-weight: 500;
    }
    tr:hover {
      background-color: #f5f5f5;
    }
  </style>
</head>
<body>
  <h1>Bucket Contents</h1>
  <table>
    <thead>
      <tr>
        <th>Object</th>
        <th>Type</th>
        <th>Storage Class</th>
        <th>Size</th>
        <th>Modified</th>
      </tr>
    </thead>
    <tbody>
      <% objects.forEach(object => { %>
        <tr>
          <td><%= object.key %></td>
          <td><%= object.contentType %></td>
          <td><%= object.storageClass %></td>
          <td><%= object.size %></td>
          <td><%= object.lastModified %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</body>
</html>
