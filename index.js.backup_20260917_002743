app.get('/api/images/:key', async (req, res) => {
  try {
    const { key } = req.params;
    const redisKey = `temp:${key}`;
    const result = await cacheGet(redisKey);

    if (!result.success || !result.data) return res.status(404).send('Image not found');

    res.setHeader('Content-Type', 'image/png'); // or image/jpeg
    res.send(Buffer.from(result.data, 'base64'));
  } catch (err) {
    console.error('Error in /api/images/:key:', err);
    res.status(500).json({ error: 'Server error while retrieving image' });
  }
});


app.get("/images/temp", async (req, res) => {
  try {
    const key = req.query.key;
    if (!key) return logResponseDetails(req, res, { error: "Missing key" }, req.path, 400);

    const result = await cacheGet(key);
    if (!result.success || !result.data) return logResponseDetails(req, res, { error: "Not found" }, req.path, 404);

    const parsed = result.data;
    res.set("Content-Type", parsed.mimetype);
    res.send(Buffer.from(parsed.buffer, "base64"));
  } catch (err) {
    console.error("Error in /images/temp:", err);
    return res.status(500).json({ error: "Server error while retrieving temp image" });
  }
});


