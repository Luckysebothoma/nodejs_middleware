PGHOST=192.168.0.140
PGDATABASE=yummies
PGPASSWORD=92a65c97f1f9a8f33894f20d2ef687eb8d982b3248dc258d8483eada500ea6ad
PGPORT=5431
TELEGRAF_URL=http://telegraf-nodejs:8186/metrics
RABBITMQ_URL=amqp://admin:cbeb8726798a50165d9ea03f22e16a9c67da8295e6bb007f52ba9653a0f313fe@rabbitmq:5672
