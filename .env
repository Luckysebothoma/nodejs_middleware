
# -------------------------- USER PROFILE
# uid=33(www-data) gid=33(www-data) groups=33(www-data)


# uid=1000(mini) gid=128(docker) groups=128(docker),4(adm),24(cdrom),27(sudo),30(dip),46(plugdev),100(users),105(lpadmin),125(sambashare),1000(mini)

# 
#    group_add:
#      - 33                  # Add container to the root group
#      - 102
#      - 65534

PUID=999
PGID=999

# -------------------------- FILE DIR


BACKUP_DIR="/backups/mysql"

REDIS_USERNAME="system"
REDIS_PASSWORD="system@123"

#=---------------------------------------
#   | Schedule      | Expression     |
#   | ------------- | -------------- |
#   | Every hour    | `0 * * * *`    |
#   | Every 6 hours | `0 */6 * * *`  |
#   | Daily at 1am  | `0 1 * * *`    |
#   | Every 15 min  | `*/15 * * * *` |


# PostgreSQL connection info
POSTGRES_HOST="postgres-db-container"
POSTGRES_PORT="5432"
POSTGRES_USER="momo"
POSTGRES_PASSWORD="@momo.17"
POSTGRES_DATABASE="yummies"
POSTGRES_DB="yummies"
# Backup schedule and settings
SCHEDULE="*/15 * * * *"
BACKUP_DIR=/backups
MAX_BACKUPS=10

REDIS_PASSWORD="Redis@001"
MYSQL_ROOT_USER= "root"
MYSQL_ROOT_PASSWORD="mini@001" 
MYSQL_DATABASE="mydb"
MYSQL_USER="mini"
MYSQL_PASSWORD="@mini.17"
MYSQL_HOST="sweety-mysql-container"
MYSQL_PORT="3306"

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=system
REDIS_PASSWORD=system@123


PUSHGATEWAY_URL="http://pushgateway-container:9091"

MYSQL_NEXTCLOUD="nextcloud"
